# ─── Zabbix ───────────────────────────────────────────────
ZABBIX_URL=https://zabbix.example.com

# Opción 1: API Token (recomendado, Zabbix 5.4+)
ZABBIX_TOKEN=

# Opción 2: Usuario + Contraseña (fallback si no hay token)
ZABBIX_USER=Admin
ZABBIX_PASS=

# ─── NetBox ───────────────────────────────────────────────
NETBOX_URL=https://netbox.example.com
NETBOX_TOKEN=

# Observium (Community via DB + CLI)
OBSERVIUM_BASE_URL=https://observium.example.com
OBSERVIUM_DB_HOST=db
OBSERVIUM_DB_PORT=3306
OBSERVIUM_DB_NAME=observium
OBSERVIUM_DB_USER=observium_user
OBSERVIUM_DB_PASSWORD=
OBSERVIUM_CONTAINER=observium-app
APP_DB_PATH=/app/data/zneditor.db
