# Secret provider
SECRET_PROVIDER=environment
CUSTOM_SECRET_PROVIDER_CLASS=
VAULT_ADDR=
VAULT_TOKEN=
VAULT_KV_MOUNT=secret
VAULT_KV_PATH_PREFIX=zabbix-netbox-unified
VAULT_KV_VERSION=v2
OUTBOUND_TLS_VERIFY=true
VAULT_TLS_VERIFY=true
ZABBIX_TLS_VERIFY=true
NETBOX_TLS_VERIFY=true
OBSERVIUM_WEB_TLS_VERIFY=true

# ─── Zabbix ───────────────────────────────────────────────
ZABBIX_URL=https://zabbix.miempresa.com

# Opción 1: API Token (recomendado, Zabbix 5.4+)
ZABBIX_TOKEN=

# Opción 2: Usuario + Contraseña (fallback si no hay token)
ZABBIX_USER=Admin
ZABBIX_PASS=

# ─── NetBox ───────────────────────────────────────────────
NETBOX_URL=https://netbox.miempresa.com
NETBOX_TOKEN=

# Observium (Community via DB + CLI)
OBSERVIUM_BASE_URL=https://observium.arsfuturo.com.do
OBSERVIUM_WEB_USER=
OBSERVIUM_WEB_PASS=
OBSERVIUM_WEB_PASS_B64=
OBSERVIUM_DB_HOST=mariadb
OBSERVIUM_DB_PORT=3306
OBSERVIUM_DB_NAME=observium
OBSERVIUM_DB_USER=observium
OBSERVIUM_DB_PASSWORD=
OBSERVIUM_CONTAINER=observium-app
OBSERVIUM_ENABLE_POLLER=false
OBSERVIUM_DISCOVERY_MODULES=os,ports,ports-stack,vlans,inventory,neighbours,ip-addresses,arp-table,mibs
APP_DB_PATH=/app/data/zneditor.db
